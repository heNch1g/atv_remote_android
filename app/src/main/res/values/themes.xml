<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      The remote is always dark, like the hardware it imitates. Both system
      bars are transparent with light icons, so the app's gradient runs to the
      screen edges instead of ending at a white strip.
    -->
    <style name="Theme.AppleTVRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#0B0B0D</item>
        <item name="android:colorBackground">#0B0B0D</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
